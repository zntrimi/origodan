<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainer">

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/return_jp_keyboard_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/symbol_return_keyboard"
            android:scaleType="center"
            android:src="@drawable/language_japanese_kana_24px"
            android:tint="?attr/colorOnSurface" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/symbol_panel_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/symbol_mode_emoji"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/emoji_search_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/emoji_search"
            android:scaleType="center"
            android:src="@drawable/baseline_search_24"
            android:tint="?attr/colorOnSurface" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/symbol_keyboard_delete_key"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/symbol_delete"
            android:scaleType="center"
            android:src="@drawable/backspace_24px"
            android:tint="?attr/colorOnSurface" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/mode_tab_layout"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/bottom_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tabGravity="fill"
        app:tabMode="fixed"
        app:tabTextColor="?attr/colorOnSurface"
        app:tabSelectedTextColor="?attr/colorPrimary"
        app:tabIndicatorColor="?attr/colorPrimary"
        app:tabIndicatorHeight="3dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/symbol_candidate_recycler_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        app:layout_constraintTop_toBottomOf="@id/mode_tab_layout"
        app:layout_constraintBottom_toTopOf="@id/category_tab_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/symbol_empty_state"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/symbol_empty_history"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/symbol_candidate_recycler_view"
        app:layout_constraintBottom_toBottomOf="@id/symbol_candidate_recycler_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/category_tab_layout"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tabGravity="start"
        app:tabMinWidth="48dp"
        app:tabPaddingStart="12dp"
        app:tabPaddingEnd="12dp"
        app:tabIconTint="@color/tab_icon_color_selector"
        app:tabIndicatorColor="?attr/colorPrimary"
        app:tabIndicatorHeight="3dp"
        app:tabMode="scrollable" />
</androidx.constraintlayout.widget.ConstraintLayout>
